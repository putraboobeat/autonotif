# ============================================
# OCA Interaction Configuration
# ============================================
OCA_URL=https://interaction.ocaindonesia.co.id/
OCA_EMAIL=your-email@example.com
OCA_PASSWORD=your-password-here

# Department filter (dari URL, bisa kosong untuk semua)
OCA_DEPARTMENT_FILTER=

# ============================================
# StarSender WhatsApp API
# ============================================
STARSENDER_API_KEY=your-starsender-api-key
WA_GROUP_NAME=Nama Group WhatsApp

# Admin Kanwil — menerima SEMUA notifikasi pengaduan
KANWIL_ADMIN_NAME=Admin Kanwil
KANWIL_ADMIN_PHONE=08xxxxxxxxxx

# Kasubbag Umum dan Hubungan Masyarakat Kanwil — menerima eskalasi jika tiket > 1x24 jam berstatus OPEN
KASUBBAG_UMUM_HUMAS_NAME="Kasubbag Umum dan Hubungan Masyarakat"
KASUBBAG_UMUM_HUMAS_PHONE=08xxxxxxxxxx

# ============================================
# GoWA Fallback Gateway (kirim ke nomor baru / cold numbers)
# Menggunakan aldinokemal/go-whatsapp-web-multidevice
# ============================================
# Provider utama: 'starsender' (default) atau 'gowa' (full GoWA)
WA_GATEWAY_PROVIDER=starsender

# Auto-fallback ke GoWA jika StarSender gagal (true/false)
GOWA_FALLBACK_ENABLED=true

# Strategi untuk nomor yang belum pernah di-chat:
# - gowa_first  : Nomor baru langsung pakai GoWA, nomor lama pakai StarSender
# - starsender_first : Selalu coba StarSender dulu, fallback GoWA jika gagal
# - gowa_only   : Semua pengiriman personal pakai GoWA
COLD_NUMBER_STRATEGY=gowa_first

# GoWA REST API endpoints (sesuaikan port jika beda)
GOWA_SEND_URL=http://localhost:3000/send/message
GOWA_GROUP_URL=http://localhost:3000/send/group
GOWA_API_KEY=

# ============================================
# Application Settings
# ============================================
SCRAPE_INTERVAL=60000
DASHBOARD_PORT=3000
NODE_ENV=production

# ============================================
# Session / Cookie storage path
# ============================================
COOKIE_PATH=./data/cookies.json
