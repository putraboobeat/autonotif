# ============================================
# OCA Interaction Configuration
# ============================================
OCA_URL=https://interaction.ocaindonesia.co.id/
OCA_EMAIL=your-email@example.com
OCA_PASSWORD=your-password-here

# Department filter (dari URL, bisa kosong untuk semua)
OCA_DEPARTMENT_FILTER=

# ============================================
# StarSender WhatsApp API
# ============================================
STARSENDER_API_KEY=your-starsender-api-key
WA_GROUP_NAME=Nama Group WhatsApp

# Admin Kanwil — menerima SEMUA notifikasi pengaduan
KANWIL_ADMIN_NAME=Admin Kanwil
KANWIL_ADMIN_PHONE=08xxxxxxxxxx

# ============================================
# Application Settings
# ============================================
SCRAPE_INTERVAL=60000
DASHBOARD_PORT=3000
NODE_ENV=production

# ============================================
# Session / Cookie storage path
# ============================================
COOKIE_PATH=./data/cookies.json
